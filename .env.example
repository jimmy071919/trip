# ---- Map Trip Planner configuration ----
# Copy to .env and change every value marked CHANGE ME. Never commit .env.

# Host port for the web UI (http://<host>:WEB_PORT). WEB_BIND=127.0.0.1 to only listen locally.
WEB_PORT=8080
WEB_BIND=0.0.0.0

# PostgreSQL (internal only, not exposed to the host)
POSTGRES_DB=trip
POSTGRES_USER=trip
POSTGRES_PASSWORD=CHANGE_ME_db_password

# Session signing key. Generate with:  openssl rand -hex 32
SECRET_KEY=CHANGE_ME_long_random_string

# Initial administrator. Used only when the database has no user yet.
# Leave both empty to create the admin from the web UI on first visit instead.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Set to true when served over HTTPS (behind a TLS reverse proxy)
COOKIE_SECURE=false

# Time zone for logs / new projects
TZ=Asia/Taipei
DEFAULT_TIMEZONE=Asia/Taipei

# Map tiles. The default OSM tile server is for light personal use only;
# see https://operations.osmfoundation.org/policies/tiles/ and use a commercial
# or self-hosted provider for public / high-traffic deployments.
TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
TILE_ATTRIBUTION='&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
TILE_MAX_ZOOM=19

# Expose interactive API docs at /api/v1/docs
ENABLE_DOCS=true

# Google Maps links: pasting a Google Maps share link always extracts the place
# name + coordinates from the URL. Set an API key (Places API (New) enabled) to
# also fill address / phone / website / opening hours. Billed by Google per lookup.
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_LANGUAGE=zh-TW
